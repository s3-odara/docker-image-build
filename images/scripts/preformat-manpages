#!/bin/bash
set -euo pipefail

log() {
    echo "[preformat-manpages] $*"
}

prune_stale_catpages() {
    local temp_root="$1"
    local allowed_list rel sec_dir base

    allowed_list="$(mktemp /tmp/man-allowed.XXXXXX)"

    while IFS= read -r rel; do
        sec_dir="${rel%%/*}"
        base="${rel##*/}"
        base="${base%.gz}"
        printf '%s/%s.0\n' "${sec_dir/#man/cat}" "${base%.*}" >>"$allowed_list"
    done < <(
        awk '
            FNR == 1 { in_files = 0 }
            $0 == "%FILES%" { in_files = 1; next }
            in_files && $0 ~ /^usr\/share\/man\/man[^/]+\/[^/]+$/ { print substr($0, 15) }
        ' /var/lib/pacman/local/*/files 2>/dev/null | sort -u
    )

    while IFS= read -r -d '' src; do
        rel="${src#"$temp_root"/}"
        if ! grep -Fxq "$rel" "$allowed_list"; then
            rm -f "$src"
        fi
    done < <(
        find "$temp_root" -mindepth 2 -maxdepth 2 \
            \( -type f -o -type l \) \
            -path "$temp_root/cat*/*" \
            -print0
    )

    find "$temp_root" -depth -type d -empty -delete
    rm -f "$allowed_list"
}

main() {
    local man_root="/usr/share/man"
    local temp_root
    local src rel sec_dir cat_dir base dst failed_src

    [ -d "$man_root" ] || return 0
    temp_root="$(mktemp -d /tmp/man-preformatted.XXXXXX)"

    while IFS= read -r -d '' src; do
        rel="${src#"$man_root"/}"
        cat_dir="$temp_root/$rel"
        install -d "$(dirname "$cat_dir")"
        cp -a "$src" "$cat_dir"
    done < <(
        find "$man_root" -mindepth 2 -maxdepth 2 \
            \( -type f -o -type l \) \
            -path "$man_root/cat*/*" \
            -print0
    )

    while IFS= read -r -d '' src; do
        rel="${src#"$man_root"/}"

        sec_dir="${rel%%/*}"
        cat_dir="$temp_root/${sec_dir/#man/cat}"
        base="${src##*/}"
        base="${base%.gz}"
        dst="$cat_dir/${base%.*}.0"

        install -d "$cat_dir"

        if man -l -T utf8 "$src" >"$dst" 2>/dev/null; then
            continue
        fi

        if mandoc -T utf8 "$src" >"$dst" 2>/dev/null; then
            continue
        fi

        rm -f "$dst"
        failed_src="$temp_root/$rel"
        install -d "$(dirname "$failed_src")"
        cp -a "$src" "$failed_src"
        log "Skipped: $rel"
    done < <(
        find "$man_root" -mindepth 2 -maxdepth 2 \
            \( -type f -o -type l \) \
            -path "$man_root/man*/*" \
            -print0
    )

    prune_stale_catpages "$temp_root"

    find "$man_root" -mindepth 1 -maxdepth 1 -type d -exec rm -rf -- {} +
    find "$man_root" -mindepth 1 -maxdepth 1 -type f ! -name 'mandoc.db' -delete
    find "$man_root" -mindepth 1 -maxdepth 1 -type l -delete

    if find "$temp_root" -mindepth 1 -print -quit | grep -q .; then
        cp -a "$temp_root"/. "$man_root"/
        makewhatis "$man_root" >/dev/null 2>&1 || true
        log "Refreshed preformatted English manpages."
    else
        log "No preformatted manpages were generated."
    fi

    rm -rf "$temp_root"
}

main "$@"
